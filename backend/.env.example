# ---- core ----
PORT=5000
NODE_ENV=development

# Comma-separated list. Every origin that will call this API.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---- database ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# ---- email notification (Resend) ----
# Leave RESEND_API_KEY empty to disable email; messages still get saved to MongoDB.
RESEND_API_KEY=
OWNER_EMAIL=ronitparmar.work@gmail.com
FROM_EMAIL=Portfolio <onboarding@resend.dev>

# ---- github stats ----
GITHUB_USERNAME=ronitparmar24
# Optional fine-grained token with NO scopes (public data only).
# Without it you get 60 req/hr per IP; with it, 5000 req/hr.
GITHUB_TOKEN=

# ---- spam protection (optional, Cloudflare Turnstile) ----
# Leave empty to fall back to honeypot + rate limit only.
TURNSTILE_SECRET_KEY=

# ---- privacy ----
# Random string used to hash visitor IPs before storing them.
IP_HASH_SALT=change-this-to-a-long-random-string
